# ==============================================================================
# RG_OCR ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and replace placeholders with your actual keys
# ==============================================================================

# --- SUPABASE CONFIGURATION (Free Tier) ---
# Found in: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key

# --- PYTHON OCR MICROSERVICE ---
OCR_SERVICE_HOST=127.0.0.1
OCR_SERVICE_PORT=8000
OCR_API_KEY=rg_ocr_secret_token_change_in_production
OCR_MAX_IMAGE_SIZE_MB=10

# --- AUTOMATION & NODE-RED ---
NODE_RED_PORT=1880
WHATSAPP_SESSION_PATH=./automation/node_red/.wwebjs_auth
WEBHOOK_SECRET=crm_webhook_secure_token_123

# --- FLUTTER APPLICATION ---
# Base URL for Flutter app to contact the OCR microservice
API_OCR_BASE_URL=http://127.0.0.1:8000
